---
import "@fontsource-variable/archivo/standard.css";
import "../styles/global.css";

const repo = "https://github.com/p4ik/mlx-beam";
const install = `uv tool install "mlx-beam @ git+${repo}"\nbeam doctor`;

const built = [
  {
    title: "Prefix cache with checkpoints",
    text: "Recurrent state is saved at segment boundaries, so a long conversation resumes from disk instead of re-prefilling.",
  },
  {
    title: "Multi-token prediction in the batch",
    text: "Speculative decoding inside continuous batching, with the rollback that makes it exact.",
  },
  {
    title: "Expert streaming",
    text: "Routed experts stay on SSD behind a resident pool, for models larger than memory.",
  },
];

const status = [
  { piece: "CLI, packaging, CI", state: "skeleton", built: true },
  { piece: "Vendored mlx-lm base", state: "planned", built: false },
  { piece: "Prefix cache with recurrent-state checkpoints", state: "planned", built: false },
  { piece: "Multi-token prediction in the batch", state: "planned", built: false },
  { piece: "Expert streaming from SSD", state: "planned", built: false },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mlx-beam</title>
    <meta
      name="description"
      content="An inference engine for hybrid-attention and mixture-of-experts models on Apple silicon, built on MLX."
    />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a class="brand" href="./">
          <span class="name">mlx-beam</span>
          <span class="expands">Batched Engine for Apple Metal</span>
        </a>
        <nav>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/blob/main/CHANGELOG.md`}>Changelog</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="wrap">
          <h1>An inference engine for the models a plain transformer server gets wrong.</h1>
          <p class="lead">
            Hybrid attention and mixture-of-experts on Apple silicon, built on MLX: recurrent state that
            cannot be trimmed, experts that do not fit in memory, speculative decoding under batching.
          </p>
        </div>
      </section>

      <div class="beam" aria-hidden="true">
        <span class="glow"></span>
        <span class="line"></span>
        <span class="core"></span>
      </div>

      <section>
        <div class="wrap">
          <div class="terminal">
            <pre><code>{install}</code></pre>
            <button type="button" data-copy>Copy</button>
          </div>
          <p class="note"><code>beam doctor</code> reports the Python, MLX, device and memory it sees.</p>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2>Built for</h2>
          <dl>
            {built.map((b) => (
              <div>
                <dt>{b.title}</dt>
                <dd>{b.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section>
        <div class="wrap">
          <h2>Status</h2>
          <table>
            <tbody>
              {status.map((s) => (
                <tr>
                  <td>{s.piece}</td>
                  <td class="state"><span class={`mark ${s.built ? "built" : "planned"}`}></span>{s.state}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note">Measured numbers are published as they are measured, with machine, model and date.</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p>Apache-2.0. Vendored components keep their own licenses.</p>
        <nav>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        </nav>
      </div>
    </footer>

    <script>
      const beam = document.querySelector(".beam");
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.closest(".terminal")?.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
            button.classList.add("done");
            beam?.classList.remove("pulse");
            void beam?.offsetWidth;
            beam?.classList.add("pulse");
            setTimeout(() => {
              button.textContent = "Copy";
              button.classList.remove("done");
            }, 1600);
          } catch {
            button.textContent = "Select and copy";
          }
        });
      });
    </script>
  </body>
</html>
