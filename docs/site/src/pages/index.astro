---
import "@fontsource-variable/archivo/standard.css";
import "../styles/global.css";
import Header from "../components/Header.astro";

const repo = "https://github.com/p4ik/mlx-beam";
const install = `uv tool install mlx-beam\nbeam doctor`;

// The same list as the README's "Features": present tense only for what
// is built, planned things say so. Extras are packages or optional installs.
const featureGroups = [
  {
    "group": "Server and APIs",
    "rows": [
      {
        "name": "OpenAI API",
        "text": "Chat completions, completions, Responses and models, with streaming.",
        "state": "built",
        "built": true
      },
      {
        "name": "Anthropic API",
        "text": "Messages with thinking blocks and tool use, on the same token path.",
        "state": "built",
        "built": true
      },
      {
        "name": "Health and metrics",
        "text": "/health shows each capability with evidence; /metrics serves counters.",
        "state": "built",
        "built": true
      },
      {
        "name": "Access control",
        "text": "An API key is required off loopback; Host check and CORS allowlist.",
        "state": "built",
        "built": true
      },
      {
        "name": "CLI",
        "text": "beam serve takes mlx-lm's flag names; beam doctor checks the machine.",
        "state": "built",
        "built": true
      }
    ]
  },
  {
    "group": "Models",
    "rows": [
      {
        "name": "Model classes",
        "text": "Dense, MoE, hybrid-recurrent, sliding window, sinks, MLA, MRoPE.",
        "state": "built",
        "built": true
      },
      {
        "name": "Package layout",
        "text": "Manifest with KV profile and draft-head quantization; plain MLX loads too.",
        "state": "built",
        "built": true
      },
      {
        "name": "Vision [Extra]",
        "text": "Qwen3-VL/3.5/3.6/3.8, Mistral 3, Gemma 4, Muse Glimmer, Granite.",
        "state": "built",
        "built": true
      },
      {
        "name": "Audio [Extra]",
        "text": "Audio input for models that take it, as its own package.",
        "state": "planned",
        "built": false
      },
      {
        "name": "Images [Extra]",
        "text": "Image generation and editing through the Images API.",
        "state": "planned",
        "built": false
      },
      {
        "name": "GGUF [Extra]",
        "text": "GGUF checkpoints load behind a guard.",
        "state": "planned",
        "built": false
      }
    ]
  },
  {
    "group": "Engine",
    "rows": [
      {
        "name": "Continuous batching",
        "text": "Short requests are answered beside a long prefill, capped by a valve.",
        "state": "built",
        "built": true
      },
      {
        "name": "Prefix cache",
        "text": "The KV of a shared prefix is reused, for recurrent and window layers too.",
        "state": "built",
        "built": true
      },
      {
        "name": "Prefix cache SSD tier",
        "text": "A second tier on SSD lets entries outlive eviction from RAM and restarts.",
        "state": "planned",
        "built": false
      },
      {
        "name": "Mixed-precision KV cache",
        "text": "Bits per layer come from the conversion; quantized after or during prefill.",
        "state": "built",
        "built": true
      },
      {
        "name": "Multi-token prediction",
        "text": "An own draft head predicts ahead, verified exactly, one request at a time.",
        "state": "built",
        "built": true
      },
      {
        "name": "Batched MTP",
        "text": "Several requests speculate at once.",
        "state": "planned",
        "built": false
      },
      {
        "name": "Expert streaming",
        "text": "Models larger than memory run with experts streamed from SSD.",
        "state": "planned",
        "built": false
      }
    ]
  },
  {
    "group": "Request control",
    "rows": [
      {
        "name": "Reasoning control",
        "text": "Thinking on or off, a budget per request, effort levels, marker families.",
        "state": "built",
        "built": true
      },
      {
        "name": "Tool calling",
        "text": "Parsers per model family and a repair ladder that reports every step.",
        "state": "built",
        "built": true
      },
      {
        "name": "Sampling controls",
        "text": "Temperature, top-p/k, min-p, penalties, logit bias, seeds and defaults.",
        "state": "built",
        "built": true
      },
      {
        "name": "Structured [Extra]",
        "text": "JSON schema and grammar-constrained decoding.",
        "state": "planned",
        "built": false
      }
    ]
  }
];

const features = ["Robust prefix cache", "Expert streaming", "No bloat"];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mlx-beam</title>
    <meta
      name="description"
      content="A light, modular inference engine for Apple silicon, built on MLX: robust prefix cache, expert streaming, no bloat."
    />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="wrap">
          <h1>B.E.A.M.</h1>
          <p class="lead">Light and modular inference engine, built on MLX.</p>
          <p class="lead-terms">
            {features.map((f, i) => (
              <>
                {i > 0 && " "}
                <span class="term">
                  {f}
                  {i < features.length - 1 && <span class="sep" aria-hidden="true">&#8226;</span>}
                </span>
              </>
            ))}
          </p>
        </div>
      </section>

      <div class="beam" aria-hidden="true">
        <span class="glow"></span>
        <span class="line"></span>
        <span class="core"></span>
      </div>

      <section id="how">
        <div class="wrap">
          <h2>How to install</h2>
          <div class="terminal">
            <pre><code>{install}</code></pre>
            <button type="button" data-copy>Copy</button>
          </div>
          <p class="note"><code>beam doctor</code> reports the Python, MLX, device and memory it sees.</p>
        </div>
      </section>

      <section id="what">
        <div class="wrap">
          <h2>Features</h2>
          <p class="prose">Everything the engine does, with where each piece stands. Extras are packages or optional installs beside the core.</p>
          <div class="features">
            {featureGroups.map((g) => (
              <section class="fgroup">
                <header>
                  <h3>{g.group}</h3>
                  <span class="count">{g.rows.filter((r) => r.built).length} of {g.rows.length} built</span>
                </header>
                <ul class="panel">
                  {g.rows.map((r) => (
                    <li class={r.built ? "built" : "planned"}>
                      <span class="fhead">
                        <span class="fname">{r.name}</span>
                        <span class="fstate">{r.state}<i class="mark" aria-hidden="true"></i></span>
                      </span>
                      <span class="ftext">{r.text}</span>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
          <p class="note">Measured numbers are published as they are measured, with machine, model and date.</p>
        </div>
      </section>

      <section id="why">
        <div class="wrap">
          <h2>Why it exists</h2>
          <p class="prose">
            Existing MLX servers either stop at the basics or grow things that have no place in an
            inference engine, and the ones we ran daily had bugs where it matters most: prefix cache,
            batching under load, vision. B.E.A.M. keeps the core to the token path and fixes those paths
            at the source; everything else is a package or an extra you choose to install.
          </p>
        </div>
      </section>

    </main>

    <footer>
      <div class="wrap">
        <p>Apache-2.0. Vendored components keep their own licenses.</p>
        <nav>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        </nav>
      </div>
    </footer>

    <script>
      const beam = document.querySelector(".beam");
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.closest(".terminal")?.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
            button.classList.add("done");
            beam?.classList.remove("pulse");
            void beam?.offsetWidth;
            beam?.classList.add("pulse");
            setTimeout(() => {
              button.textContent = "Copy";
              button.classList.remove("done");
            }, 1600);
          } catch {
            button.textContent = "Select and copy";
          }
        });
      });
    </script>
  </body>
</html>
