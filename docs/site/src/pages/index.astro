---
import "@fontsource-variable/archivo/standard.css";
import "../styles/global.css";
import Header from "../components/Header.astro";

const repo = "https://github.com/p4ik/mlx-beam";
const install = `uv tool install mlx-beam\nbeam doctor`;

// The same list as the README's "Features": present tense only for what
// is built, planned things say so.
const featureList = [
  { title: "Robust prefix cache", text: "Trie-backed store with its own byte budget, checkpoints for hybrid models, partial hits cut back to the last usable boundary.", state: "built, RAM tier; SSD tier planned", built: true },
  { title: "No stalls", text: "A short request beside a long prefill answers in seconds: continuous batching with a prefill valve.", state: "built", built: true },
  { title: "Mixed-precision KV cache", text: "Bits per layer, set at conversion. Quantized after the prefill by default; from the first token for profiles measured that way.", state: "built", built: true },
  { title: "Multi-token prediction", text: "The checkpoint's own draft head, verified exactly, greedy or sampled; a regulator picks the depth per cycle.", state: "built for one request at a time; in the batch planned", built: true },
  { title: "Thinking budget", text: "A hard cap on the reasoning trace, per request, next to request defaults and sampling controls.", state: "built", built: true },
  { title: "Responses and Messages APIs", text: "OpenAI's Responses shape and Anthropic's Messages shape next to chat completions, stateless; /metrics; a repair ladder for tool calls the model wrote badly.", state: "built", built: true },
  { title: "Vision", text: "Its own package, mlx-beam-vision, selected through the vision extra: Qwen3-VL / Qwen3.5 / Qwen3.8, Mistral 3, Gemma 4, Muse Glimmer and Granite Vision towers. Audio will join it.", state: "built", built: true },
  { title: "Structured output, GGUF", text: "Extras with a guard: a request that needs what is not installed gets a clear refusal.", state: "planned", built: false },
  { title: "Expert streaming", text: "Models larger than memory, their experts streamed from SSD.", state: "planned", built: false },
  { title: "No bloat", text: "The core is the token path and the API formats; everything else is a package or an extra you choose to install. Nothing in the core talks to the network on its own.", state: "built", built: true },
];

const features = ["Robust prefix cache", "Expert streaming", "No bloat"];

---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mlx-beam</title>
    <meta
      name="description"
      content="A light, modular inference engine for Apple silicon, built on MLX: robust prefix cache, expert streaming, no bloat."
    />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="wrap">
          <h1>B.E.A.M.</h1>
          <p class="lead">Light and modular inference engine, built on MLX.</p>
          <p class="lead-terms">
            {features.map((f, i) => (
              <>
                {i > 0 && " "}
                <span class="term">
                  {f}
                  {i < features.length - 1 && <span class="sep" aria-hidden="true">&#8226;</span>}
                </span>
              </>
            ))}
          </p>
        </div>
      </section>

      <div class="beam" aria-hidden="true">
        <span class="glow"></span>
        <span class="line"></span>
        <span class="core"></span>
      </div>

      <section id="how">
        <div class="wrap">
          <h2>How to install</h2>
          <div class="terminal">
            <pre><code>{install}</code></pre>
            <button type="button" data-copy>Copy</button>
          </div>
          <p class="note"><code>beam doctor</code> reports the Python, MLX, device and memory it sees.</p>
        </div>
      </section>

      <section id="what">
        <div class="wrap">
          <h2>Features</h2>
          <dl>
            {featureList.map((f) => (
              <div>
                <dt>
                  {f.title}
                  <span class="state"><span class={`mark ${f.built ? "built" : "planned"}`}></span>{f.state}</span>
                </dt>
                <dd>{f.text}</dd>
              </div>
            ))}
          </dl>
          <p class="note">Measured numbers are published as they are measured, with machine, model and date.</p>
        </div>
      </section>

      <section id="why">
        <div class="wrap">
          <h2>Why it exists</h2>
          <p class="prose">
            Existing MLX servers either stop at the basics or grow things that have no place in an
            inference engine: a built-in game, a cloud path that arrives with an update. The ones we ran
            daily also had bugs where it matters most: prefix cache, batching under load, vision.
            B.E.A.M. keeps the core to the token path and fixes those paths at the source. Everything
            else is a package or an extra you choose to install; nothing ever ships in the core that you
            did not ask for.
          </p>
        </div>
      </section>

    </main>

    <footer>
      <div class="wrap">
        <p>Apache-2.0. Vendored components keep their own licenses.</p>
        <nav>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        </nav>
      </div>
    </footer>

    <script>
      const beam = document.querySelector(".beam");
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.closest(".terminal")?.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
            button.classList.add("done");
            beam?.classList.remove("pulse");
            void beam?.offsetWidth;
            beam?.classList.add("pulse");
            setTimeout(() => {
              button.textContent = "Copy";
              button.classList.remove("done");
            }, 1600);
          } catch {
            button.textContent = "Select and copy";
          }
        });
      });
    </script>
  </body>
</html>
