---
import "@fontsource-variable/archivo/standard.css";
import "../styles/global.css";
import Header from "../components/Header.astro";

const repo = "https://github.com/p4ik/mlx-beam";
const install = `uv tool install mlx-beam\nbeam doctor`;

// The same list as the README's "What sets it apart": present tense only
// for what is built, planned things say so.
const built = [
  { title: "Robust prefix cache", text: "Trie-backed store with its own byte budget, checkpoints for hybrid models, partial hits cut back to the last usable boundary. An SSD tier that survives restarts is planned." },
  { title: "No stalls", text: "A short request beside a long prefill answers in seconds." },
  { title: "Mixed-precision KV cache", text: "Bits per layer, set at conversion. Quantized after the prefill by default; from the first token for profiles measured that way." },
  { title: "Multi-token prediction", text: "The checkpoint's own draft head, verified exactly, greedy or sampled. On today for one request at a time; in the batch planned." },
  { title: "Thinking budget", text: "A hard cap on the reasoning trace, per request." },
  { title: "Responses and Messages APIs", text: "OpenAI's Responses shape and Anthropic's Messages shape next to chat completions, stateless." },
  { title: "No bloat", text: "The core is the token path and the API formats. Vision and audio will come as their own package, structured output and GGUF as extras with a guard - none of them in this release yet. Expert streaming for models larger than memory is planned." },
];


const features = ["Robust prefix cache", "Exact speculative decoding", "No bloat"];

const status = [
  { piece: "CLI, packaging, CI", state: "built", built: true },
  { piece: "Vendored mlx-lm base", state: "built", built: true },
  { piece: "OpenAI server with continuous batching, quantized KV cache", state: "built", built: true },
  { piece: "Prefix cache with recurrent-state checkpoints, RAM tier", state: "built", built: true },
  { piece: "Multi-token prediction, one request at a time, greedy or sampled", state: "built", built: true },
  { piece: "Prefix cache SSD tier", state: "planned", built: false },
  { piece: "Multi-token prediction in the batch and under sampling", state: "planned", built: false },
  { piece: "Vision, structured output", state: "planned", built: false },
  { piece: "Expert streaming from SSD", state: "planned", built: false },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>mlx-beam</title>
    <meta
      name="description"
      content="A light, modular inference engine for Apple silicon, built on MLX: robust prefix cache, exact speculative decoding, no bloat."
    />
    <meta name="theme-color" content="#000000" />
  </head>
  <body>
    <Header />

    <main>
      <section class="hero">
        <div class="wrap">
          <h1>B.E.A.M.</h1>
          <p class="lead">Light and modular inference engine, built on MLX.</p>
          <p class="lead-terms">
            {features.map((f, i) => (
              <>
                {i > 0 && " "}
                <span class="term">
                  {f}
                  {i < features.length - 1 && <span class="sep" aria-hidden="true">&#8226;</span>}
                </span>
              </>
            ))}
          </p>
        </div>
      </section>

      <div class="beam" aria-hidden="true">
        <span class="glow"></span>
        <span class="line"></span>
        <span class="core"></span>
      </div>

      <section id="how">
        <div class="wrap">
          <h2>How to install</h2>
          <div class="terminal">
            <pre><code>{install}</code></pre>
            <button type="button" data-copy>Copy</button>
          </div>
          <p class="note"><code>beam doctor</code> reports the Python, MLX, device and memory it sees.</p>
        </div>
      </section>

      <section id="what">
        <div class="wrap">
          <h2>What sets it apart</h2>
          <dl>
            {built.map((b) => (
              <div>
                <dt>{b.title}</dt>
                <dd>{b.text}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <section id="why">
        <div class="wrap">
          <h2>Why it exists</h2>
          <p class="prose">
            Existing MLX servers either stop at the basics or grow things that have no place in an
            inference engine: a built-in game, a cloud path that arrives with an update. The ones we ran
            daily also had bugs where it matters most: prefix cache, batching under load, vision.
            B.E.A.M. keeps the core to the token path and fixes those paths at the source. Everything
            else is a package or an extra you choose to install; nothing ever ships in the core that you
            did not ask for.
          </p>
        </div>
      </section>

      <section id="where">
        <div class="wrap">
          <h2>Where it stands</h2>
          <table>
            <tbody>
              {status.map((s) => (
                <tr>
                  <td>{s.piece}</td>
                  <td class="state"><span class={`mark ${s.built ? "built" : "planned"}`}></span>{s.state}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note">Measured numbers are published as they are measured, with machine, model and date.</p>
        </div>
      </section>
    </main>

    <footer>
      <div class="wrap">
        <p>Apache-2.0. Vendored components keep their own licenses.</p>
        <nav>
          <a href={repo}>GitHub</a>
          <a href={`${repo}/blob/main/CONTRIBUTING.md`}>Contributing</a>
        </nav>
      </div>
    </footer>

    <script>
      const beam = document.querySelector(".beam");
      document.querySelectorAll("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.closest(".terminal")?.querySelector("code")?.textContent ?? "";
          try {
            await navigator.clipboard.writeText(text);
            button.textContent = "Copied";
            button.classList.add("done");
            beam?.classList.remove("pulse");
            void beam?.offsetWidth;
            beam?.classList.add("pulse");
            setTimeout(() => {
              button.textContent = "Copy";
              button.classList.remove("done");
            }, 1600);
          } catch {
            button.textContent = "Select and copy";
          }
        });
      });
    </script>
  </body>
</html>
