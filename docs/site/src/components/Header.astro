---
// The one navigation every page shows. The current page is marked with
// aria-current, so the styling has a real attribute to hang on, and links
// that leave the site say so.
const repo = "https://github.com/p4ik/mlx-beam";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const here = Astro.url.pathname.replace(/\/$/, "");

const pages = [
  { href: `${base}/`, label: "Home", path: base },
  { href: `${base}/configuration/`, label: "Configuration", path: `${base}/configuration` },
];
const external = [
  { href: repo, label: "GitHub" },
  { href: `${repo}/blob/main/CHANGELOG.md`, label: "Changelog" },
];
---

<header class="top">
  <div class="wrap">
    <a class="brand" href={`${base}/`}>
      <span class="name">mlx-beam</span>
      <span class="expands">Batched Engine for Apple Metal</span>
    </a>
    <nav aria-label="Site">
      {pages.map((p) => (
        <a href={p.href} aria-current={here === p.path ? "page" : undefined}>{p.label}</a>
      ))}
      {external.map((e) => (
        <a href={e.href} class="external" rel="noopener">{e.label}<span aria-hidden="true">&nbsp;↗</span></a>
      ))}
    </nav>
  </div>
</header>
